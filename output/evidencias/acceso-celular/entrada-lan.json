{
  "kind": "IngressRoute",
  "apiVersion": "traefik.io/v1alpha1",
  "spec": {
    "routes": [
      {
        "services": [
          {
            "name": "frontend",
            "port": 8080
          }
        ],
        "kind": "Rule",
        "match": "Host(`192.168.100.3`)"
      }
    ],
    "entryPoints": [
      "websecure"
    ],
    "tls": {
      "secretName": "tienda-tls"
    }
  },
  "metadata": {
    "namespace": "tienda-prod",
    "name": "tienda-lan"
  }
}
