CI_ENV=production
APP_BASE_URL=http://localhost:8080/
APP_SESSION_DRIVER=database
APP_ENCRYPTION_KEY=replace-with-a-random-64-character-value
APP_COOKIE_SECURE=false
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=tienda_app
DB_PASSWORD=replace-locally
DB_SSLMODE=prefer
MONGO_DATABASE=tienda
MONGO_URI=mongodb://tienda_app:replace-locally@mongo:27017/tienda?authSource=tienda

DB_OWNER_PASSWORD=replace-owner-password
MONGO_OWNER_PASSWORD=replace-mongo-owner-password
MONGO_APP_PASSWORD=replace-locally
MONGO_OWNER_URI=mongodb://tienda_owner:replace-mongo-owner-password@mongo:27017/tienda?authSource=admin
SEED_ADMIN_PASSWORD=replace-demo-admin-password
SEED_CLIENT_PASSWORD=replace-demo-client-password
