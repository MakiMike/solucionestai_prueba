# Copiar a secrets.env y sustituir todos los valores. No subir secretos al repositorio.
DB_PASSWORD=replace-app-password
DB_OWNER_PASSWORD=replace-owner-password
MONGO_APP_PASSWORD=replace-mongo-app-password
MONGO_OWNER_PASSWORD=replace-mongo-owner-password
MONGO_URI=mongodb://tienda_app:replace-mongo-app-password@mongo:27017/tienda?authSource=tienda
MONGO_OWNER_URI=mongodb://tienda_owner:replace-mongo-owner-password@mongo:27017/tienda?authSource=admin
APP_ENCRYPTION_KEY=replace-random-64-character-key
SEED_ADMIN_PASSWORD=replace-demo-admin-password
SEED_CLIENT_PASSWORD=replace-demo-client-password
